# AGENT_SECRET gates /ws/ext and every session route. Leave it empty and
# `docker compose up` refuses to start and says why, which is the behaviour
# you want. Do not paste a value here: whatever is in this file is published
# in the repository, and this secret protects a relay that can drive a
# logged-in browser.
#
# Generate one instead:
#   python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
AGENT_SECRET=

# ── Hosted relay only. Self-host needs none of these, and setting one
# turns the whole file above off: SUPABASE_JWT_SECRET takes precedence and
# the relay then authenticates with Supabase session tokens instead of a
# shared secret. Supabase's own docs carry the values (Project Settings →
# API); they must never be committed here for the same reason as above.
#
# SUPABASE_JWT_SECRET=            # JWT secret — verified locally per request
# SUPABASE_URL=                   # https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=      # reads profiles at task start (revoke + cap)
# SUPABASE_ANON_KEY=              # the two sign-in routes only
#
# Optional, hosted only. Left unset, retention defaults to 30 days on the
# hosted relay and off everywhere else — see BROTTO_RETENTION_DAYS.
# BROTTO_RETENTION_DAYS=30
# BROTTO_BETA_TASK_CAP=10