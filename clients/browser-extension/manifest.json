{
  "manifest_version": 3,
  "name": "Agentic Browser Automation (ABA)",
  "version": "1.0.0",
  "description": "Run authenticated, recoverable canonical browser-agent sessions with local policy enforcement",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Agentic Browser Automation (ABA)"
  },
  "permissions": [
    "debugger",
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_page": "options.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "fara15-browser-extension@inventic.ch"
    }
  }
}
