{
  "name": "@brotto/browser-extension",
  "version": "1.0.0",
  "description": "Brotto Browser Extension - Drives your real Chrome via the Brotto orchestrator",
  "main": "src/background.js",
  "scripts": {
    "build": "node build.mjs",
    "build:tsc": "tsc --noEmit",
    "dev": "npm run build && npm run watch",
    "watch": "tsc --watch",
    "test": "node test.mjs",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx,.js",
    "prettier": "prettier --write \"src/**/*.{ts,tsx,js,html}\"",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "brotto",
    "browser-extension",
    "chrome-extension",
    "side-panel",
    "browser-automation",
    "model-agnostic"
  ],
  "author": "Inventic",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "esbuild": "^0.28.1",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@brotto/brotto-action-schema": "workspace:*",
    "@brotto/relay-protocol": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx"
    ],
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "moduleNameMapper": {
      "^@brotto/brotto-action-schema$": "<rootDir>/../../packages/brotto-action-schema/src/index.ts",
      "^@brotto/relay-protocol$": "<rootDir>/../../packages/brotto-relay-protocol/src/index.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
