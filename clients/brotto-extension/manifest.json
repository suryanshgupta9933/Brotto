{
  "manifest_version": 3,
  "name": "Brotto",
  "version": "1.0.0",
  "description": "Let you ask an AI to perform tasks in your own logged-in browser. Bring your own model key.",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Brotto",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "debugger",
    "notifications",
    "storage",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
