{
  "name": "@brotto/evals-unit",
  "version": "0.1.0",
  "private": true,
  "description": "Unit test suite for Brotto core packages",
  "type": "module",
  "scripts": {
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "test:coordinate-transform": "cd ../packages/coordinate-transform && npm test",
    "test:brotto-action-schema": "cd ../packages/brotto-action-schema && npm test",
    "test:policy-engine": "cd ../packages/policy-engine && npm test",
    "test:relay-protocol": "cd ../packages/brotto-relay-protocol && npm test"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@brotto/coordinate-transform": "workspace:*",
    "@brotto/brotto-action-schema": "workspace:*",
    "policy-engine": "workspace:*",
    "@brotto/relay-protocol": "workspace:*"
  }
}
